<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>N</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background-color: #000;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    canvas {
      display: block;
    }
  </style>
</head>
<body>
  <canvas id="heartCanvas"></canvas>

  <script>
    const canvas = document.getElementById('heartCanvas');
    const ctx = canvas.getContext('2d');

    let width = canvas.width = window.innerWidth;
    let height = canvas.height = window.innerHeight;

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const text = "I love you";
    const letter = "N";
    const totalWords = 110;
    let visibleWords = 0;
    let angleOffset = 0;
    let time = 0;

    // Вспомогательная функция для вычисления точки на кубической кривой Безье
    function getBezierPoint(t, p0, p1, p2, p3) {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      const uuu = uu * u;
      const ttt = tt * t;
      return {
        x: uuu * p0.x + 3 * uu * t * p1.x + 3 * u * tt * p2.x + ttt * p3.x,
        y: uuu * p0.y + 3 * uu * t * p1.y + 3 * u * tt * p2.y + ttt * p3.y
      };
    }

    // Генерируем точки контура жеста «finger heart» из кривых
    function buildHandPoints() {
      const curves = [
        // 1. Внешний контур ладони и большого пальца (слева)
        {
          pts: [
            { x: -18, y: -38 },
            { x: -24, y: -12 },
            { x: -38, y: 12 },
            { x: -28, y: 38 }
          ],
          steps: 26
        },
        // 2. Низ ладони и правый край
        {
          pts: [
            { x: -28, y: 38 },
            { x: -12, y: 54 },
            { x: 24, y: 48 },
            { x: 32, y: 16 }
          ],
          steps: 26
        },
        // 3. Большой палец (верхняя дуга + правый край до перекрестия)
        {
          pts: [
            { x: -18, y: -38 },
            { x: -18, y: -52 },
            { x: -4, y: -50 },
            { x: -3, y: -34 }
          ],
          steps: 14
        },
        // 4. Указательный палец (идёт снизу-слева вверх-вправо поверх большого)
        {
          pts: [
            { x: -14, y: -6 },
            { x: -6, y: -28 },
            { x: 2, y: -52 },
            { x: 11, y: -50 }
          ],
          steps: 18
        },
        // 5. Правый край указательного пальца вниз
        {
          pts: [
            { x: 11, y: -50 },
            { x: 20, y: -48 },
            { x: 10, y: -24 },
            { x: 2, y: -4 }
          ],
          steps: 18
        },
        // 6. Средний согнутый палец
        {
          pts: [
            { x: 6, y: -15 },
            { x: 20, y: -24 },
            { x: 26, y: -8 },
            { x: 14, y: 4 }
          ],
          steps: 14
        },
        // 7. Безымянный согнутый палец
        {
          pts: [
            { x: 14, y: 2 },
            { x: 28, y: -4 },
            { x: 32, y: 10 },
            { x: 20, y: 20 }
          ],
          steps: 13
        },
        // 8. Мизинец
        {
          pts: [
            { x: 20, y: 18 },
            { x: 33, y: 14 },
            { x: 36, y: 26 },
            { x: 24, y: 34 }
          ],
          steps: 12
        }
      ];

      const points = [];
      for (const c of curves) {
        for (let i = 0; i <= c.steps; i++) {
          const t = i / c.steps;
          points.push(getBezierPoint(t, c.pts[0], c.pts[1], c.pts[2], c.pts[3]));
        }
      }
      return points;
    }

    const handPoints = buildHandPoints();

    function getHeartPoint(t) {
      const x = 16 * Math.pow(Math.sin(t), 3);
      const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
      return { x, y };
    }

    function animate() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
      ctx.fillRect(0, 0, width, height);

      time += 0.03;
      angleOffset += 0.008;

      if (visibleWords < totalWords) {
        visibleWords += 0.7;
      }

      const progress = Math.min(1, visibleWords / totalWords);
      const beat = 1 + Math.sin(time * 2.5) * 0.04;
      const baseScale = Math.min(width, height) / 54;
      const scale = baseScale * beat;

      // ==========================================
      // 1. ВЕРХНИЙ БЛОК: Жест пальцами из букв "N"
      // ==========================================
      ctx.save();
      // Позиция жеста в верхней части экрана
      ctx.translate(width / 2, height * 0.23);
      const handScale = (baseScale / 13) * (1 + Math.sin(time * 2.5 + 0.5) * 0.03);

      ctx.font = `bold ${Math.max(9, Math.floor(baseScale * 0.85))}px "Courier New", monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.shadowColor = '#ff69b4';
      ctx.shadowBlur = 10;

      const visibleHandCount = Math.floor(handPoints.length * progress);
      for (let i = 0; i < visibleHandCount; i++) {
        const pt = handPoints[i];
        // Лёгкое живое колыхание букв вдоль контура руки
        const wave = Math.sin(time * 3 + i * 0.25) * 0.6;
        ctx.fillStyle = 'rgba(255, 220, 235, 0.92)';
        ctx.fillText(letter, pt.x * handScale + wave, pt.y * handScale);
      }
      ctx.restore();

      // ==========================================
      // 2. НИЖНИЙ БЛОК: Сердце из "I love you" + "N"
      // ==========================================
      ctx.save();
      ctx.translate(width / 2, height * 0.63);

      // Буква N в центре сердца
      ctx.save();
      ctx.font = `bold ${Math.floor(baseScale * 6.5 * beat)}px "Georgia", serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.shadowColor = '#ff69b4';
      ctx.shadowBlur = 25;
      ctx.fillStyle = `rgba(255, 225, 240, ${Math.min(1, visibleWords / 40) * 0.95})`;
      ctx.fillText(letter, 0, baseScale * 0.8);
      ctx.restore();

      // Контур сердца из слов "I love you"
      ctx.rotate(-0.35);
      ctx.font = `bold ${Math.max(11, Math.floor(scale * 0.88))}px "Courier New", monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      const count = Math.floor(visibleWords);
      for (let i = 0; i < count; i++) {
        const t = (i / totalWords) * Math.PI * 2 + angleOffset;
        const pos = getHeartPoint(t);

        ctx.save();
        ctx.translate(pos.x * scale, pos.y * scale);
        ctx.rotate(-0.45);

        ctx.shadowColor = '#ff69b4';
        ctx.shadowBlur = 12;
        ctx.fillStyle = 'rgba(255, 220, 235, 0.9)';
        ctx.fillText(text, 0, 0);
        ctx.restore();
      }

      ctx.restore();
      requestAnimationFrame(animate);
    }

    animate();
  </script>
</body>
</html>
